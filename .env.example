# ── NASA FIRMS API key ───────────────────────────────────────────────────────
# Get your free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_key_here

# Optional overrides for NRT fetch (leave commented out to use defaults)
# FIRMS_SOURCE=VIIRS_SNPP_NRT     # satellite source
# FIRMS_DAY_RANGE=7               # days of data to fetch (1-10)

# ── Historical Archive Fetch (fetch_firms_archive.py) ─────────────────────────
# Default: 1 full year ending yesterday.  Override as needed.
# FIRMS_ARCHIVE_START=2025-09-01   # YYYY-MM-DD start date
# FIRMS_ARCHIVE_END=2026-09-02     # YYYY-MM-DD end date (exclusive)
# FIRMS_ARCHIVE_SOURCES=VIIRS_SNPP_NRT,MODIS_NRT


# ── Email Alerts (Gmail SMTP) ─────────────────────────────────────────────────
# Set ALERT_EMAIL_ENABLED=true to activate alerts after Step 4.
ALERT_EMAIL_ENABLED=false

# Your Gmail address used to SEND the alert
SMTP_USER=your_gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Enable 2-Step Verification first, then create an App Password for "Mail".
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Comma-separated list of recipient email addresses
ALERT_RECIPIENTS=recipient@example.com

# Optional overrides (safe to leave as defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# FRP threshold in MW — only alert if hotspot intensity >= this value.
# Set to 0 to alert on ALL Wildfire Risk detections.
ALERT_FRP_THRESHOLD=0
