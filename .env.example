# NASA FIRMS API key
# Get your free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_key_here

# Optional overrides (leave commented out to use defaults)
# FIRMS_SOURCE=VIIRS_SNPP_NRT     # satellite source
# FIRMS_DAY_RANGE=7               # days of data to fetch (1-10)
